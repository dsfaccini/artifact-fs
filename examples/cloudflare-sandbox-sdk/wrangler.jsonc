{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "artifact-fs-sandbox-sdk-v1-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "name": "artifact-fs-sandbox-sdk-v1",
      "scheduling_policy": "durable_object",
      "images": {
        "artifactfs": {
          "dockerfile": "./Dockerfile",
          "build_context": "../../"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    }
  ]
}
